# === Data (media, DB, sessions — user-specific) ===
data/samourais.db*

# Sauvegardes de data/ — elles contiennent la base ET les cookies de session.
# Le motif ci-dessus ne couvre que `data/` : une copie posée à la racine
# (data-sauvegarde-*, data-backup-*, data-copie-*) y échappait et a bien failli
# partir sur GitHub. Le bon endroit pour une sauvegarde est HORS du dépôt.
data-sauvegarde*/
data-backup*/
data-copie*/
*.db-wal
*.db-shm
data/downloads/*
data/sessions/*
data/cookies/*
data/editor/*
data/calendar/*
!data/**/.gitkeep

# === Environment & Secrets ===
.env
.env.local
.env.production
*.log

# === Python ===
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
.eggs/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# === Node (legacy) ===
node_modules/
dist/

# === OS ===
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# === IDE ===
.vscode/
.idea/
*.code-workspace

# Marqueur d'etat d'execution ecrit par run.py au demarrage : ce n'est pas du code.
data/.samourais_volume_marker
